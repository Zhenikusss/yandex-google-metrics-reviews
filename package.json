{
  "name": "yandex-google-metrics-reviews",
  "version": "0.1.0",
  "description": "Метрики и отзывы сети точек с Яндекс.Карт и Google Maps: сбор одним вызовом, JSON-отчёт и письмо",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "yandex-google-metrics-reviews": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "branches.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "tsx index.ts",
    "test:yandex-metrics": "tsx yandex-parser/metrika.ts",
    "test:yandex-reviews": "tsx yandex-parser/reviews.ts",
    "test:google-metrics": "tsx google-parser/metrika.ts",
    "test:google-reviews": "tsx google-parser/reviews.ts"
  },
  "keywords": [
    "yandex-maps",
    "google-maps",
    "business-profile",
    "reviews",
    "metrika",
    "scraper"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhenikusss/yandex-google-metrics-reviews.git"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^10.0.3",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}

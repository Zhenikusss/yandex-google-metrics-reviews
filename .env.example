# Copy to .env and fill in the values of your chain

# --- Yandex ---
# OAuth token of an application with Metrika API access
YANDEX_METRIKA_TOKEN=
# Metrika counter id linked to the business organization card
YANDEX_COUNTER_ID=
# Chain page URL on Yandex Maps (the source of the branch list)
YANDEX_CHAIN_URL=

# --- Google ---
# OAuth client from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long-lived refresh token (OAuth Playground, scope business.manage)
GOOGLE_REFRESH_TOKEN=

# --- Report email (optional: without it the report is only daily_report.json) ---
# SMTP server of your mailbox provider:
#   Yandex: smtp.yandex.ru, Gmail: smtp.gmail.com, Mail.ru: smtp.mail.ru
SMTP_HOST=
# SMTP port (465 = SSL)
SMTP_PORT=465
SMTP_USER=
# App password (NOT the main mailbox password!)
SMTP_PASS=
# Recipients, comma-separated
MAIL_TO=
# Browser profile dir of the reviews scraper: the captcha clearance cookies
# persist between runs, so a passed captcha keeps the next runs clean
# (default: .yandex-profile in the working directory)
# YANDEX_PROFILE_DIR=
# How long to keep retrying the automatic captcha checkbox tick, ms
# (default: 120000; 0 - fail immediately)
# YANDEX_CAPTCHA_WAIT_MS=

# Recipients for PARTIAL reports only (a platform failed to collect) -
# the developer; without it partial reports go to MAIL_TO as well
# MAIL_ERRORS_TO=
